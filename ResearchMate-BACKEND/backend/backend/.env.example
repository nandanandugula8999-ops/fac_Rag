# Faculty Research Discovery Assistant - environment configuration
#
# Copy to `.env` and fill in. The `.env` file is gitignored; never commit real
# credentials. Every variable is optional - defaults are defined in
# src/faculty_radar/config/settings.py and the engine boots without this file.
#
# Naming convention: FR_<GROUP>__<FIELD>, with `__` nesting groups.

# ---------------------------------------------------------------- app
FR_APP__ENV=local
FR_APP__DEBUG=false

# ---------------------------------------------------------------- paths
# Leave unset to use <project root>/data and <project root>/logs.
# Set these to move the data lake onto a larger disk.
# FR_PATHS__DATA=D:\faculty-data
# FR_PATHS__LOGS=D:\faculty-data\logs

# ---------------------------------------------------------------- logging
FR_LOGGING__LEVEL=INFO
FR_LOGGING__FORMAT=text
FR_LOGGING__FILE_ENABLED=true
# FR_LOGGING__FILE_NAME=faculty_radar.log
FR_LOGGING__CONSOLE_ENABLED=true
FR_LOGGING__SILENCE_THIRD_PARTY=true

# ---------------------------------------------------------------- openalex
# OpenAlex grants a faster, more reliable "polite pool" to callers that
# identify themselves with a mailto address. Strongly recommended.
FR_OPENALEX__MAILTO=you@university.edu
# Optional. Only needed for higher rate limits.
# FR_OPENALEX__API_KEY=
FR_OPENALEX__BASE_URL=https://api.openalex.org
FR_OPENALEX__TIMEOUT_SECONDS=30
FR_OPENALEX__MAX_RETRIES=3
FR_OPENALEX__PAGE_SIZE=200
FR_OPENALEX__REQUESTS_PER_SECOND=10

# ---------------------------------------------------------------- crossref
# Crossref verifies/enriches discovered publications (DOI validity, title
# agreement, missing titles/years/landing URLs). OpenAlex stays the primary
# discovery source; if Crossref is down or disabled, discovery transparently
# falls back to OpenAlex-only. No key needed; mailto joins the polite pool.
FR_CROSSREF__ENABLED=true
# FR_CROSSREF__MAILTO=you@university.edu
# FR_CROSSREF__TIMEOUT_SECONDS=8.0
# FR_CROSSREF__MAX_WORKERS=8

# ---------------------------------------------------------------- scope
# Which institution's faculty the engine may reason about. Required before
# ingestion. OpenAlex institution IDs look like I185315811.
#
# Replace the example ID below with your own institution's OpenAlex ID.
# Look it up with:  https://api.openalex.org/institutions?search=Your+University
#
# These are intentionally commented out: a fresh clone should report an
# unconfigured scope in `fr doctor` rather than silently ingest someone
# else's institution.
# FR_SCOPE__INSTITUTION_IDS=["I185315811"]
# FR_SCOPE__INSTITUTION_NAMES=["Your University"]
# Topic queries used to seed ingestion.
# FR_SCOPE__TOPIC_SEEDS=["graph neural networks", "CRISPR gene editing"]
# Only index faculty who have consented to being discoverable. Leave true.
FR_SCOPE__REQUIRE_CONSENT=true

# ---------------------------------------------------------------- groq (server-side only)
# Groq Llama provider for research intelligence. NEVER put this key in frontend
# code (no VITE_GROQ_API_KEY / NEXT_PUBLIC_GROQ_API_KEY).
# FR_GROQ__API_KEY=gsk_...
# FR_GROQ__MODEL=llama-3.1-8b-instant
# FR_LLM__PROVIDER=extractive   # extractive | groq | ollama (ollama = future stub)
